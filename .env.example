# Copy to .env and fill in. Real environment variables take precedence over this file.

# Required
SPREADSHEET_ID=
# One of these two is required:
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-key.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Optional
MCP_TOKEN=            # bearer token Chord sends; /mcp is open if empty
ADMIN_TOKEN=          # X-Admin-Token for /admin/unifi-outage; route is off if empty
# PORT=8000
# CACHE_SECONDS=5
